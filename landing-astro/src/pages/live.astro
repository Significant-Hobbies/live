---
import { GalleryPage } from '@saas-maker/templates/gallery-page';
import { galleryContent } from '@saas-maker/templates/schema';
import { EXPERIENCE_ENTRIES } from '../../../src/lib/experiences';
import json from '../content/live.json';
import Layout from '../layouts/Layout.astro';
import ResponsiveImages from '../components/ResponsiveImages.astro';

const content = galleryContent.parse({
  ...json,
  sections: json.sections.map((section) => section.kind === 'grid'
    ? { ...section, lede: section.lede?.replace('{count}', String(EXPERIENCE_ENTRIES.length)) }
    : section),
});
---

<Layout content={content}>
  <ResponsiveImages>
    <GalleryPage content={content} />
  </ResponsiveImages>
</Layout>
