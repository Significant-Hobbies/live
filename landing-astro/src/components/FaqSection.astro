---
const faqs = [
  {
    q: 'What is Live?',
    a: 'Live is the Significant Hobbies product for deciding what you want to experience and keeping an honest record of it. It brings together hobby discovery, bucket lists, commitments, timelines, side quests, and personal history.',
  },
  {
    q: 'Is Live free?',
    a: 'Yes. Live is currently free to use and there is no paid plan or checkout. You can begin without creating an account.',
  },
  {
    q: 'Do I need an account?',
    a: 'No. Signed-out private work stays on this device. Sign in with Google when you want your supported records to persist across devices or when you choose to publish a Live surface.',
  },
  {
    q: 'Where should I start?',
    a: 'Start with the hobby quiz. Nine focused questions lead to personalized recommendations and a concrete first experiment. From there, save an idea, make a commitment, or map it into your timeline.',
  },
  {
    q: 'What can I keep in Live?',
    a: 'Live supports bucket lists, hobby-specific commitments, life-phase timelines, side quests, discovery plans, and the personal history that accumulates behind them. The life-in-weeks view makes the time around those choices concrete.',
  },
  {
    q: 'Is my work public?',
    a: 'Not by default. Live publication is opt-in per supported item. Public timelines and profiles can be shared by link, while private work remains private unless you explicitly choose otherwise.',
  },
  {
    q: 'Where are Journal and Habits?',
    a: 'Journal and Habits are separate Significant Hobbies products with focused jobs. Live owns discovery, plans, experiences, and history; it does not present private writing or simple habit check-ins as if they were the same product.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<section class="bg-[#dceabf] px-6 py-28 lg:px-12 lg:py-36">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
    <div>
      <h2 class="font-serif text-4xl font-medium tracking-tight text-foreground sm:text-5xl">
        Questions, answered.
      </h2>
      <p class="mt-5 max-w-sm leading-relaxed text-muted-foreground">
        Start free without an account. Keep control of what is public. Choose one
        thing worth doing next.
      </p>
    </div>

    <div class="border-t border-border">
      {
        faqs.map((faq) => (
          <details class="group border-b border-border">
            <summary class="flex min-h-20 cursor-pointer list-none items-center justify-between gap-5 py-5 text-left">
              <h3 class="text-lg font-semibold text-foreground sm:text-xl">{faq.q}</h3>
              <span
                class="flex h-11 w-11 flex-shrink-0 items-center justify-center text-primary transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M8 1v14M1 8h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="max-w-2xl pb-7 pr-14 text-[15px] leading-relaxed text-muted-foreground">
              {faq.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
