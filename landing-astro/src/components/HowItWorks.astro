---
const steps = [
  {
    number: '01',
    title: 'Find something to do',
    desc: 'Search the catalog for bucket-list ideas, places, and small adventures.',
    detail: 'Search or browse',
    accent: 'oklch(0.36 0.11 150)',
  },
  {
    number: '02',
    title: 'Keep your own list',
    desc: 'Save the things you want to try. Add your own, mark them done, or make a Bingo board.',
    detail: 'One list, your choices',
    accent: 'oklch(0.40 0.12 72)',
  },
  {
    number: '03',
    title: 'Remember your week',
    desc: 'Log a habit when you do it. Write one private journal entry about the previous week.',
    detail: 'Private by default',
    accent: 'oklch(0.36 0.09 230)',
  },
];
---

<section class="bg-[#c5abfa] px-6 py-28 lg:px-12 lg:py-36">
  <div class="mx-auto max-w-6xl">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div>
        <p class="mb-5 text-base font-medium text-primary">Discover. Choose. Remember.</p>
        <h2
          class="font-serif text-4xl font-medium tracking-tight text-foreground sm:text-5xl"
          style="line-height: 1.05;"
        >
          Turn “someday” into a life you can actually see.
        </h2>
        <a
          href="/experiences"
          class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-full bg-primary px-6 text-sm font-semibold text-primary-foreground no-underline transition-colors hover:bg-foreground focus-visible:ring-2 focus-visible:ring-foreground focus-visible:ring-offset-4 focus-visible:ring-offset-background focus-visible:outline-none"
        >
          Explore the catalog <span aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="list-none border-t border-border">
        {
          steps.map((step) => (
            <li class="grid gap-5 border-b border-border py-8 sm:grid-cols-[4rem_1fr_auto] sm:items-start sm:gap-7 sm:py-10">
              <span class="font-serif text-2xl font-medium" style={`color: ${step.accent};`}>
                {step.number}
              </span>
              <div>
                <h3 class="text-xl font-semibold text-foreground sm:text-2xl">{step.title}</h3>
                <p class="mt-3 max-w-xl leading-relaxed text-muted-foreground">{step.desc}</p>
              </div>
              <p class="self-center text-sm font-medium text-foreground sm:max-w-44 sm:text-right">
                {step.detail}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
