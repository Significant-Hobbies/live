---
import { publicIdentity } from '../../../src/lib/public-identity';
import Base from '@saas-maker/templates/Base.astro';
import '../styles/landing.css';
import { baseProps } from '@saas-maker/templates/page';
import type { GalleryContent } from '@saas-maker/templates/schema';
import headingFont from '@saas-maker/ui/fonts/fraunces-latin-normal.woff2?url';

interface Props {
  content: GalleryContent;
}
const { content } = Astro.props;
const SITE_URL = 'https://significanthobbies.com';
const faq = content.sections.find((section) => section.kind === 'faq');
const faqJsonLd = faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="hobby discovery, life phases hobbies, hobby timeline, bucket list, find your hobby, hobby quiz, life planner"
    />
    <meta name="author" content="Significant Hobbies" />
    <meta name="theme-color" content="#1a1a1a" />
    <script is:inline>
      (function(c,l,a,r,i){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        var done=0,ev=["pointerdown","keydown","touchstart","scroll"],timer;
        function go(){
          if(done)return;done=1;clearTimeout(timer);
          ev.forEach(function(e){removeEventListener(e,go)});
          var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        }
        ev.forEach(function(e){addEventListener(e,go,{passive:true,once:true})});
        timer=setTimeout(go,90000);
      })(window,document,"clarity","script","ybcglnzl4t");
      window.clarity("set","project_id","live");
    </script>
    <link rel="preload" href="/hero/live-hero-v3.webp" as="image" type="image/webp" imagesrcset="/hero/live-hero-v3-640.webp 640w, /hero/live-hero-v3-800.webp 800w, /hero/live-hero-v3-960.webp 960w, /hero/live-hero-v3-1200.webp 1200w, /hero/live-hero-v3.webp 1280w" imagesizes="100vw" fetchpriority="high" />
    <!-- The hero uses Fraunces; discover its face early instead of an unused serif. -->
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="ai-summary" content={content.page.description} />
    <link rel="alternate" type="text/markdown" href={`${SITE_URL}/index.md`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(publicIdentity)} />
    {faqJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <script is:inline>
      // Gallery links have no data-attribute API. Register before the deferred logger.
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelector('main > section:first-child a[href="/experiences"]')
          ?.setAttribute('data-log', 'catalog_opened');
      });
    </script>
    <script is:inline src="/app-health-log.js" defer></script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_1fca6e63a5563124c98a231646298b5637b22876e6740e6a1bea9facd52006cd"
      data-project="app-404d18a1-17aa-43e9-ac6e-0f0ebbcb883b"
      data-identity="persistent"
      data-vitals
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
    ></script>
  </Fragment>
  <slot />
</Base>
