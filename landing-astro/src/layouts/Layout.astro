---
import Base from '@saas-maker/templates/Base.astro';
import { baseProps } from '@saas-maker/templates/page';
import type { GalleryContent } from '@saas-maker/templates/schema';

interface Props {
  content: GalleryContent;
}
const { content } = Astro.props;
const SITE_URL = 'https://live.significanthobbies.com';
const faq = content.sections.find((section) => section.kind === 'faq');
const faqJsonLd = faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <meta
      name="keywords"
      content="hobby discovery, life phases hobbies, hobby timeline, bucket list, find your hobby, hobby quiz, life planner"
    />
    <meta name="author" content="Significant Hobbies" />
    <meta name="theme-color" content="#1a1a1a" />
    <script is:inline>
      (function(c,l,a,r,i){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        var done=0,ev=["pointerdown","keydown","touchstart","scroll"],timer;
        function go(){
          if(done)return;done=1;clearTimeout(timer);
          ev.forEach(function(e){removeEventListener(e,go)});
          var t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          var y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        }
        ev.forEach(function(e){addEventListener(e,go,{passive:true,once:true})});
        timer=setTimeout(go,30000);
      })(window,document,"clarity","script","ybcglnzl4t");
      window.clarity("set","project_id","live");
    </script>
    <link rel="preload" href="/hero/hobby-horizon-poster.webp" as="image" type="image/webp" imagesrcset="/hero/hobby-horizon-poster-640.webp 640w, /hero/hobby-horizon-poster-960.webp 960w, /hero/hobby-horizon-poster.webp 1280w" imagesizes="(max-width: 767px) 1100px, 100vw" fetchpriority="high" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Live",
      "alternateName": ["Live by Significant Hobbies", "live.significanthobbies.com"],
      "url": SITE_URL,
      "description": "Discover hobbies and experiences worth trying, turn them into bucket lists and commitments, and keep a private-by-default record through timelines, side quests, and personal history.",
      "creator": {
        "@type": "Person",
        "name": "Sarthak Agrawal",
        "url": "https://sarthakagrawal.dev"
      }
    })} />
    {faqJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    <script is:inline>
      // Gallery links have no data-attribute API. Register before the deferred logger.
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelector('main > section:first-child a[href="/experiences"]')
          ?.setAttribute('data-log', 'catalog_opened');
      });
    </script>
    <script is:inline src="/app-health-log.js" defer></script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_ef090730a0f78d6290239fce630f06d087816ef1052993003f5c23ba9496fbbd"
      data-project="app-404d18a1-17aa-43e9-ac6e-0f0ebbcb883b"
      data-identity="persistent"
      data-vitals
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
    ></script>
  </Fragment>
  <slot />
</Base>
