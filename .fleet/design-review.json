{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "significanthobbies",
  "target": "Owned product changelog",
  "mode": "preserve",
  "register": "product",
  "context": {
    "product": "docs/product/overview.md",
    "design": "src/app/globals.css"
  },
  "direction": {
    "references": [],
    "probes": [],
    "selected": "existing-design",
    "approval": "not-required",
    "before": "artifacts/design/before.png"
  },
  "evidence": {
    "screenshots": [
      {
        "width": 390,
        "path": "artifacts/design/after-390.png"
      },
      {
        "width": 768,
        "path": "artifacts/design/after-768.png"
      },
      {
        "width": 1440,
        "path": "artifacts/design/after-1440.png"
      }
    ],
    "projectCheck": {
      "command": "pnpm typecheck && pnpm build && pnpm docs:check && git diff --check",
      "status": "pass"
    },
    "critique": {
      "score": 36,
      "maximum": 40
    },
    "audit": {
      "score": 18,
      "maximum": 20
    },
    "unresolved": {
      "p0": 0,
      "p1": 0
    },
    "detector": {
      "posture": "advisory",
      "findings": []
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "Owner explicitly delegated the owned changelog rollout on 2026-07-29."
  }
}
